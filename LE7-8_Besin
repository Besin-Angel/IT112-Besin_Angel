#include <stdio.h>
#include <ctype.h>
#include <string.h>

#define MAX_SIZE 100
#define MAX_LEN 256

int main(void) {
    /* Part 1: Largest element in an array */
    int n, i;
    int arr[MAX_SIZE];

    printf("Enter number of elements in the array: ");
    if (scanf("%d", &n) != 1 || n < 1 || n > MAX_SIZE) {
        printf("Invalid number of elements (1-%d).\n", MAX_SIZE);
        return 1;
    }

    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int largest = arr[0];
    for (i = 1; i < n; i++) {
        if (arr[i] > largest) {
            largest = arr[i];
        }
    }
    printf("The largest element in the array is: %d\n\n", largest);

    /* Part 2: Count vowels in a string */
    char str[MAX_LEN];
    int count = 0;

    /* Clear leftover newline from the previous input */
    int c;
    while ((c = getchar()) != '\n' && c != EOF);

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);
    str[strcspn(str, "\n")] = '\0';

    for (i = 0; str[i] != '\0'; i++) {
        char ch = tolower((unsigned char)str[i]);
        if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') {
            count++;
        }
    }
    printf("The number of vowels in the string is: %d\n", count);

    return 0;
}
