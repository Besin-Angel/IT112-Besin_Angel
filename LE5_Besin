#include <stdio.h>

int main() {
    int number;
    int totalSum = 0;

    printf("Enter positive numbers to ADD (zero or negative number to STOP)\n\n");

    while (1) {
        printf("Enter a number: ");
        scanf("%d", &number);

        if (number <= 0) {
            break;
        }

        totalSum += number;
    }

    printf("Total sum is: %d\n", totalSum);

    return 0;
}