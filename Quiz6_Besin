#include <stdio.h>
 
/* Determines whether a number is positive, negative, or zero,
   and whether it is even or odd, then prints the results. */
void analyzeNumber(int num)
{
    /* Positive / negative / zero check */
    if (num > 0)
    {
        printf("The number is POSITIVE.\n");
    }
    else if (num < 0)
    {
        printf("The number is NEGATIVE.\n");
    }
    else
    {
        printf("The number is ZERO.\n");
    }
 
    /* Even / odd check (num % 2 != 0 also works for negatives, since -3 % 2 == -1) */
    if (num % 2 == 0)
    {
        printf("The number is EVEN.\n");
    }
    else
    {
        printf("The number is ODD.\n");
    }
}
 
int main(void)
{
    int i, number;
 
    printf("==================================\n");
    printf("         NUMBER ANALYZER\n");
    printf("==================================\n\n");
 
    for (i = 1; i <= 5; i++)
    {
        printf("Enter number %d: ", i);
        scanf("%d", &number);
 
        analyzeNumber(number);
        printf("\n");
    }
 
    printf("Program finished.\n");
 
    return 0;
}
 
